# ---------------------------------------------------------------------------
# JARVIS environment configuration
#
# Copy this file to ".env" (same folder) and fill in the values you have.
# ".env" is git-ignored, so your secrets never get committed.
#
# Nothing in this file is required to LAUNCH JARVIS. With no values set,
# JARVIS runs in "stub mode": it echoes a clearly-labeled placeholder reply
# instead of calling a real AI model, and voice is text-only.
# ---------------------------------------------------------------------------

# --- The Brain (Anthropic / Claude) -----------------------------------------
# Get a key at https://console.anthropic.com/  (Settings -> API Keys)
# If unset, JARVIS responds with a stub reply instead of calling the API.
ANTHROPIC_API_KEY=

# Model used for the main "reasoning" calls (the primary Brain).
# Defaults to a current, capable Claude model - see config/index.ts for the
# fallback value if this is left unset.
JARVIS_MODEL_MAIN=claude-sonnet-4-5

# Model used for cheap/fast "routing" calls (FR-8.4). Phase 0 does not use
# this yet (single-path only), but the setting exists so later phases can.
JARVIS_MODEL_ROUTER=claude-haiku-4-5

# --- Cost controls ------------------------------------------------------------
# Monthly budget cap in USD (FR-8.1-8.3). Every Brain (Claude) call records
# its estimated cost to the cost ledger, based on the model's published
# per-million-token input/output pricing (see PRICE_PER_MILLION_TOKENS_USD in
# core/brain.ts - currently Sonnet 4.5 $3/$15 and Haiku 4.5 $1/$5 per million
# input/output tokens, per https://www.anthropic.com/pricing; unrecognized
# models fall back to the Sonnet rate as a conservative estimate).
#
# When the current calendar month's ledger total reaches 80% of this cap,
# the UI shows an "approaching budget cap" warning. At 100% or more, JARVIS
# switches to RESTRICTED MODE: it refuses to make further paid model calls
# for the rest of the month and instead returns a clearly-labeled stub reply
# explaining why (you can still use read-only tools and view the activity
# log / cost ledger). Raise this value (or wait until next month) to exit
# restricted mode.
JARVIS_MONTHLY_BUDGET_USD=20

# --- Credential vault ---------------------------------------------------------
# JARVIS stores integration secrets in your OS keychain (macOS Keychain,
# Windows Credential Manager, or Linux Secret Service) via the optional
# "keytar" package. If keytar is unavailable (headless Linux/CI, or the
# native module failed to build), JARVIS automatically falls back to an
# encrypted local file - see security/vault.ts for details. That fallback
# is for DEVELOPMENT/TESTING ONLY.
#
# Set this to "file" to force the local-file fallback even if a real
# keychain is available (useful for testing). Leave unset to auto-detect.
JARVIS_VAULT_BACKEND=

# Only used by the local-file vault fallback. If unset, a key is generated
# and stored next to the vault file on first run (clearly marked as dev-only).
JARVIS_VAULT_DEV_PASSPHRASE=

# --- Storage --------------------------------------------------------------------
# Path to the SQLite database file. Defaults to "./data/jarvis.db" if unset.
JARVIS_DB_PATH=

# --- Voice (optional, Phase 0 ships a text fallback + a stub adapter) ---------
# Not required to start JARVIS. Leave blank to use text-only mode.
JARVIS_VOICE_ADAPTER=text

# --- Time zone (FR-3.5) -----------------------------------------------------
# IANA time zone (e.g. "America/New_York", "Europe/London") used to resolve
# relative dates like "today" and "this week", and to display event times.
# If unset, JARVIS uses the host system's configured time zone.
JARVIS_TIME_ZONE=

# --- Google Calendar (read + write events) ----------------------------------
# Optional. Connects JARVIS to your Google Calendar with READ + WRITE access
# to EVENTS ONLY (the "calendar.events" scope - it can list, create, edit,
# move, and delete events and their attendees, but cannot manage calendars
# themselves, sharing settings, etc.). Without these, the Google Calendar
# skill runs in stub mode (clearly-labeled placeholder data, no network
# calls, no write tools actually call Google).
#
# SCOPE UPGRADE NOTE: Phase 1 requested only "calendar.readonly". If you
# authorized JARVIS during Phase 1, you must RE-AUTHORIZE (re-run the
# one-time authorization steps in the README) to grant the new
# "calendar.events" scope before any calendar write tool (create/update/
# delete event) will work - otherwise Google will return a permission error.
#
# These same credentials are also used by the Gmail skill below - one
# Google Cloud OAuth client can request scopes for multiple Google products.
# See README "Connect your Google Calendar" and "Connect Gmail" for
# step-by-step instructions on creating these credentials.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Redirect URI registered on the Google OAuth "Desktop app" client. The
# default below matches Google's standard loopback redirect for installed
# apps - only override this if you registered a different one.
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:53682/oauth2callback

# --- Gmail (read + draft + send) ----------------------------------------------
# Optional. Connects JARVIS to your Gmail with READ access
# ("gmail.readonly" - search, read messages/threads, list unread, summarize
# inbox) plus compose access ("gmail.compose" - create drafts AND send mail
# on your behalf). Without Google OAuth credentials configured (above), the
# Gmail skill runs in stub mode (clearly-labeled placeholder data, no network
# calls).
#
# SENDING EMAIL (FR-4.4, Phase 3): JARVIS can send a real email (composed
# fresh, or from an existing draft), but send_email is Tier 2 and ALWAYS
# requires your explicit confirmation - showing the exact recipients,
# subject, and a body preview, and stating that it cannot be unsent. There is
# no way for JARVIS to send an email without you confirming that specific
# send, even in stub mode. JARVIS has NO tool to delete/trash email.
#
# Uses the SAME GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET as Google
# Calendar above - no separate client is needed. See README "Connect Gmail"
# for the one-time authorization steps (separate from the Calendar
# authorization - each skill stores its own tokens).

# --- Stripe (read-only listings + Tier 3 refunds/cancellations, TEST MODE) -----
# Optional. Connects JARVIS to your Stripe account. Read-only (FR-5.1, FR-5.2):
# get_balance, list_charges, list_payouts, list_customers, list_disputes,
# list_invoices. Write (FR-5.3, Phase 4, ALWAYS Tier 3 - confirm + TOTP
# authenticator code, R-2a): refund_charge (full or partial), and
# cancel_subscription. There are still NO tools to create new charges, change
# payout/bank details, modify account settings, or manage API keys (FR-5.4 -
# enforced by a denylist test). Without a key configured, the Stripe skill
# runs in stub mode (clearly-labeled placeholder data, zero network calls).
#
# Use a RESTRICTED key (Stripe Dashboard -> Developers -> API keys ->
# "Create restricted key") with READ-ONLY access to Balances, Charges,
# Payouts, Customers, Disputes, and Invoices, and no other permissions. A
# full secret key also works but a restricted key is recommended (least
# privilege). Either STRIPE_API_KEY or STRIPE_RESTRICTED_KEY may be used -
# they are equivalent; set one.
STRIPE_API_KEY=
STRIPE_RESTRICTED_KEY=

# SAFETY RAIL (FR-5.6 / SEC-2): JARVIS defaults to Stripe TEST MODE. If the
# configured key does not start with "sk_test_" or "rk_test_" (i.e. it looks
# like a LIVE-mode key: "sk_live_"/"rk_live_"), JARVIS REFUSES to use it and
# the Stripe skill runs in stub mode - no live Stripe call can happen by
# accident. Set this to "true" to explicitly opt into using a live-mode key
# (NOT recommended until you trust the integration).
STRIPE_ALLOW_LIVE_MODE=false

# --- Local Filesystem (JARVIS's own folder, FR-6.1..6.7) ------------------------
# JARVIS can read, write, organize, and "delete" (move to .jarvis-trash/)
# files within a SINGLE folder on your computer (FR-6.4). Defaults to
# `~/Claude 2nd brain/JARVIS/` (created automatically on first run if it
# doesn't exist). JARVIS can never access files outside this folder.
#
# Set this to use a different folder instead of the default.
JARVIS_ALLOWED_DIR=
