# ---------------------------------------------------------------------------
# JARVIS environment configuration
#
# Copy this file to ".env" (same folder) and fill in the values you have.
# ".env" is git-ignored, so your secrets never get committed.
#
# Nothing in this file is required to LAUNCH JARVIS. With no values set,
# JARVIS runs in "stub mode": it echoes a clearly-labeled placeholder reply
# instead of calling a real AI model, and voice is text-only.
# ---------------------------------------------------------------------------

# --- The Brain (Anthropic / Claude) -----------------------------------------
# Get a key at https://console.anthropic.com/  (Settings -> API Keys)
# If unset, JARVIS responds with a stub reply instead of calling the API.
ANTHROPIC_API_KEY=

# Model used for the main "reasoning" calls (the primary Brain).
# Defaults to a current, capable Claude model - see config/index.ts for the
# fallback value if this is left unset.
JARVIS_MODEL_MAIN=claude-sonnet-4-5

# Model used for cheap/fast "routing" calls (FR-8.4). Phase 0 does not use
# this yet (single-path only), but the setting exists so later phases can.
JARVIS_MODEL_ROUTER=claude-haiku-4-5

# --- Cost controls ------------------------------------------------------------
# Monthly budget cap in USD. When the cost ledger total for the current
# month reaches this amount, JARVIS should switch to restricted mode
# (read-only / text-only). Phase 0 records costs but does not yet enforce
# the cap (that lands with the confirmation/permission UI in a later phase).
JARVIS_MONTHLY_BUDGET_USD=20

# --- Credential vault ---------------------------------------------------------
# JARVIS stores integration secrets in your OS keychain (macOS Keychain,
# Windows Credential Manager, or Linux Secret Service) via the optional
# "keytar" package. If keytar is unavailable (headless Linux/CI, or the
# native module failed to build), JARVIS automatically falls back to an
# encrypted local file - see security/vault.ts for details. That fallback
# is for DEVELOPMENT/TESTING ONLY.
#
# Set this to "file" to force the local-file fallback even if a real
# keychain is available (useful for testing). Leave unset to auto-detect.
JARVIS_VAULT_BACKEND=

# Only used by the local-file vault fallback. If unset, a key is generated
# and stored next to the vault file on first run (clearly marked as dev-only).
JARVIS_VAULT_DEV_PASSPHRASE=

# --- Storage --------------------------------------------------------------------
# Path to the SQLite database file. Defaults to "./data/jarvis.db" if unset.
JARVIS_DB_PATH=

# --- Voice (optional, Phase 0 ships a text fallback + a stub adapter) ---------
# Not required to start JARVIS. Leave blank to use text-only mode.
JARVIS_VOICE_ADAPTER=text
