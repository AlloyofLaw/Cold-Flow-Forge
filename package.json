{
  "name": "beat-drew",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Beat Drew — a local-first, installable PWA that gamifies real-world improvement across Health, Wealth, and Relationships.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
