{
  "name": "lift-log",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Lift Log - a local-first, installable PWA gym session tracker with data-driven gamification.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
