{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS - a voice-first personal AI agent (Phase 0: Foundation scaffold)",
  "main": "dist/app/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "node scripts/copy-ui-assets.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --enable-logging",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^12.4.1",
    "dotenv": "^17.2.3",
    "googleapis": "^160.0.0",
    "googleapis-common": "^8.0.2"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.3",
    "electron": "^42.4.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
