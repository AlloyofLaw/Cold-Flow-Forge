{
  "name": "jarvis",
  "version": "0.1.0",
  "private": true,
  "description": "JARVIS - a voice-first personal AI agent (Phase 0: Foundation scaffold)",
  "main": "dist/app/main.js",
  "type": "commonjs",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run bundle-renderer && npm run bundle-preload && npm run copy-assets",
    "bundle-renderer": "esbuild ui/renderer.ts --bundle --platform=browser --format=iife --target=es2020 --outfile=dist/ui/renderer.js",
    "bundle-preload": "esbuild app/preload.ts --bundle --platform=node --format=cjs --target=node22 --external:electron --outfile=dist/app/preload.js",
    "copy-assets": "node scripts/copy-ui-assets.js",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --enable-logging",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.2.3",
    "googleapis": "^160.0.0",
    "googleapis-common": "^8.0.2",
    "otplib": "^13.4.1",
    "stripe": "^18.5.0"
  },
  "optionalDependencies": {
    "keytar": "^7.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "electron": "^42.4.0",
    "esbuild": "^0.25.12",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.0",
    "vitest": "^4.1.8"
  },
  "engines": {
    "node": ">=22"
  }
}
